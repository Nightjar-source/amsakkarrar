<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      نسخة الوضع الليلي مطابقة تمامًا للثيم الأساسي (التطبيق داكن في الحالتين).
      أُبقيت لمنع أي اختلاف في الألوان عند تفعيل الوضع الليلي على النظام.
    -->
    <style name="Theme.Caliq" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
