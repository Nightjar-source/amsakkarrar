<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      الوضع المظلم: خلفية #070B13 مطابقة لأول لون في لوحة الوضع الداكن،
      وأيقونات أشرطة فاتحة. شاشة البداية نفسها داكنة في الحالتين.
    -->
    <style name="Theme.Caliq" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Caliq.Splash" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="windowSplashScreenBackground">@drawable/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_safe</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Caliq</item>
    </style>
</resources>
