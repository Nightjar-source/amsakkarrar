<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      الثيم الأساسي داكن دائمًا (التطبيق ليلي فقط، لا يوجد وضع فاتح).
      Parent داكن مقصود: يضبط ألوان أيقونات شريط الحالة/التنقل، ويمنع وميض
      الإطار الأول الفاتح قبل رسم Compose، ويوحّد مؤشر تحديد النص.
    -->
    <style name="Theme.Caliq" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <!-- لا يسمح للنظام بتفتيح واجهتنا الداكنة تلقائيًا -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Splash screen theme (shows while app loads) -->
    <style name="Theme.Caliq.Splash" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="windowSplashScreenBackground">@drawable/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_safe</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Caliq</item>
    </style>
</resources>
