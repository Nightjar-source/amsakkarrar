<?xml version="1.0" encoding="utf-8"?>
<!--
  نسخة الودجت 4×3 — نفس هوية الهيدر الكبير بخط Reem Kufi لكنها مكدّسة أفقيًا
  حتى تتّسع شبكة الصلوات الست تحتها داخل الخلية المتوسطة.
  شريط التقدم: صورة مرسومة (WidgetProgressStrip) بارتفاع 14dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_hero_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_kashida_pre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/reem_kufi"
                android:includeFontPadding="false"
                android:text="رمضـ"
                android:textColor="#FFFFD700"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_kashida_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/reem_kufi"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="20dp"
                android:text="16"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_kashida_post"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/reem_kufi"
                android:includeFontPadding="false"
                android:text="ـان"
                android:textColor="#FFFFD700"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_hero_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/reem_kufi"
            android:includeFontPadding="false"
            android:text="السبت 7-3-2026 • كربلاء"
            android:textColor="#E2E8F0"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hero_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="25° • صافٍ"
        android:textColor="#F8FAFC"
        android:textSize="7.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_hero_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_label_pill"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="1dp"
            android:paddingEnd="10dp"
            android:paddingBottom="1dp"
            android:text="باقي على الفجر"
            android:textColor="#FFFFD700"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_hero_chrono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layoutDirection="ltr"
            android:gravity="end"
            android:includeFontPadding="false"
            android:shadowColor="#66FFD700"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:textColor="#FFFFD700"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- شريط تقدم بيضوي سميك (14dp) — صورة مرسومة بتدرج المرجع (WidgetProgressStrip) -->
    <ImageView
        android:id="@+id/widget_hero_progress"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="3dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/widget_hero_progress_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="منتصف الليل"
            android:textColor="#99B9C0D4"
            android:textSize="6.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_hero_progress_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="الإمساك"
            android:textColor="#99B9C0D4"
            android:textSize="6.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- مربعات الصلوات الست (3×2) — نسخة compact: نصف قطر 9dp، بلا سطر الفترة،
         نفس هوية PrayerBoxCell compact في Glance (ذهبي شفاف للقادم / زجاج أبيض للباقي) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_prayer_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_cell_compact"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_prayer_1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/reem_kufi"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="الإمساك"
                    android:textColor="#B3B9C0D4"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="5:18"
                    android:textColor="#F5F5F7"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_1_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="صباحاً"
                    android:textColor="#99B9C0D4"
                    android:textSize="6sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_prayer_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_prayer_cell_compact"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_prayer_2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/reem_kufi"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="الفجر"
                    android:textColor="#B3B9C0D4"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="5:33"
                    android:textColor="#F5F5F7"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_2_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="صباحاً"
                    android:textColor="#99B9C0D4"
                    android:textSize="6sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_prayer_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_prayer_cell_compact"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_prayer_3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/reem_kufi"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="الظهر"
                    android:textColor="#B3B9C0D4"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="12:15"
                    android:textColor="#F5F5F7"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_3_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="مساءً"
                    android:textColor="#99B9C0D4"
                    android:textSize="6sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_prayer_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_cell_compact"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_prayer_4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/reem_kufi"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="العصر"
                    android:textColor="#B3B9C0D4"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="3:40"
                    android:textColor="#F5F5F7"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_4_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="مساءً"
                    android:textColor="#99B9C0D4"
                    android:textSize="6sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_prayer_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_prayer_cell_compact"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_prayer_5_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/reem_kufi"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="المغرب"
                    android:textColor="#B3B9C0D4"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="6:19"
                    android:textColor="#F5F5F7"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_5_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="مساءً"
                    android:textColor="#99B9C0D4"
                    android:textSize="6sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_prayer_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_prayer_cell_compact"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_prayer_6_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/reem_kufi"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="العشاء"
                    android:textColor="#B3B9C0D4"
                    android:textSize="6sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_6_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="7:30"
                    android:textColor="#F5F5F7"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_6_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="مساءً"
                    android:textColor="#99B9C0D4"
                    android:textSize="6sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
