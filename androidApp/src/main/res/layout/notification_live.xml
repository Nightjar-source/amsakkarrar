<?xml version="1.0" encoding="utf-8"?>
<!-- الإشعار الحي — التصميم الكامل (widgetsnotifications.html) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/notif_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- الهيدر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/notif_icon_circle"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_notif_moon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="رمضان مباشر"
            android:textColor="#FFF5F5F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:text="كربلاء"
            android:textColor="#80B9C0D4"
            android:textSize="9sp" />

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/notif_box_next">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/notif_live_dot" />
        </FrameLayout>
    </LinearLayout>

    <!-- الوقت المستهدف والعدّاد -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="باقي على الإمساك"
                android:textColor="#99B9C0D4"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/live_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layoutDirection="ltr"
                android:text="5:18 ص"
                android:textColor="#FFF5F5F7"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متبقي"
                android:textColor="#99B9C0D4"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/live_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:textColor="#FFFFD700"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- شريط التقدم (نهاري / ليلي) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp">

        <ProgressBar
            android:id="@+id/live_progress_day"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/notif_progress_day" />

        <ProgressBar
            android:id="@+id/live_progress_night"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/notif_progress" />
    </FrameLayout>
</LinearLayout>
