<?xml version="1.0" encoding="utf-8"?>
<!-- الإشعار الحي — خلفية القوس الديناميكية خلف المحتوى (widgetsnotifications.html) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/notif_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <!-- الهيدر: لهب + «العدّاد المباشر» + النقطة الحمراء النابضة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/notif_flame_circle"
                android:contentDescription="@null"
                android:padding="4dp"
                android:src="@drawable/ic_notif_flame" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="العدّاد المباشر"
                android:textColor="#FFF5F5F7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/notif_box_current">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/notif_live_dot" />
            </FrameLayout>
        </LinearLayout>

        <!-- الصف السفلي: العدّاد + الوقت المتبقي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/live_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="باقي على الإمساك"
                    android:textColor="#99B9C0D4"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/live_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layoutDirection="ltr"
                    android:text="5:18 ص"
                    android:textColor="#FFF5F5F7"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="متبقي"
                    android:textColor="#99B9C0D4"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2" />

                <Chronometer
                    android:id="@+id/live_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:textColor="#FFFFD700"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- شريط التقدم (نهاري / ليلي) h-[28px] -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="14dp">

            <ProgressBar
                android:id="@+id/live_progress_day"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/notif_progress_day" />

            <ProgressBar
                android:id="@+id/live_progress_night"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/notif_progress" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
