<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الإشعار الزجاجية — `gradient(145deg, rgba(0,0,0,.65) → rgba(20,20,30,.85))`
     مع زوايا 35px وحدّ أبيض 15% وظل عميق (من widgetsnotifications.html) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#A6000000"
        android:centerColor="#C20A0F1C"
        android:endColor="#D9141420" />
    <corners android:radius="35dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
