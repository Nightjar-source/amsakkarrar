<?xml version="1.0" encoding="utf-8"?>
<!-- شريط تقدم الودجت (نهاري) — نفس تدرج grad-day في الإشعار بالضبط
     (#FFE066 → #FF9F1C → #E71D36) حتى يبدو الشريطان شيئًا واحدًا. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="9999px" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#FFE066"
                    android:centerColor="#FF9F1C"
                    android:endColor="#E71D36" />
                <corners android:radius="9999px" />
            </shape>
        </clip>
    </item>
</layer-list>
